# ============================================================
#  Android Reverse-Engineering / Unpacking study repo
#  (360jiagu, ajiami, upx_practice, ollvm + shared PROMPT.md)
#  ollvm was an independent repo early on; its history was folded
#  into this repo (see ollvm-history-backup.bundle one level up if
#  the old commits are ever needed).
# ============================================================

# ---- Generated outputs (never commit) ----
analysis_output/
logs/
__pycache__/
*.pyc
JSON

# ollvm: gradle/NDK build tree + scratch output (regenerated by tools\analyze-apk.ps1
# and build\build.ps1); bundled Gradle dist ~146MB re-downloaded by build\bootstrap.ps1
ollvm/app/build/
ollvm/app/.gradle/
ollvm/app/.cxx/
ollvm/app/local.properties
ollvm/build/reports/
ollvm/captures/
ollvm/analysis_output/
**/gradle-8.13/

# Build outputs: keep build/*.sh, build/*.py, build/env.sh as lab tooling;
# ignore only the generated sub-directories. Use **/ so the pattern matches at
# any depth (each lab nests them under its own folder, e.g. ajiami/build/v1/).
**/build/_probe/
**/build/merged/
**/build/neg/
**/build/shell/
**/build/target/
**/build/v1/
**/build/v2/
**/build/v3/
**/build/variant/
**/build/vmp/

# Signing keystore must never be committed
*.keystore

# ---- Third-party / local binaries ----
# UPX packer binaries (upx.exe at project root, upx396.exe in tools/) are not committed.
*.exe

# PyInstaller exe build artifacts (build via unpacker/build_exe.py, not committed)
unpacker/build/
unpacker/dist/
unpacker/*.spec
unpacker/app_icon_preview.png

# Local environment overrides
local.properties
*.local

# Project-local Python virtualenv (dynamic-analysis tooling: frida-tools, etc.).
# Kept per-repo, never global: avoids polluting the machine-wide interpreter and
# avoids the websockets/langsmith version conflict a global frida install causes.
.venv/
venv/

# ---- IDE / OS junk ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- Bundle backup of the old ollvm repo history (kept local, not committed) ----
*.bundle

# ---- Real-target lab samples (see PROMPT-REAL.md) ----
# A real-target lab analyzes a THIRD-PARTY artifact it does not own. The repo commits
# only sha256 + provenance + conclusions — NEVER the binary itself (authorization /
# redistribution gate). Self-built labs (PROMPT.md) DO commit their samples, so no
# repo-wide glob is safe here: add one rule per real-target lab when you create it, e.g.
#   uncrackable/l1/samples/apks/*.apk
#   uncrackable/l1/samples/native/*.so
#   uncrackable/l1/samples/dex/*.dex
uncrackable/l1/samples/apks/*.apk
uncrackable/l1/samples/dex/*.dex
uncrackable/l1/samples/native/*.so
uncrackable/l2/samples/apks/*.apk
uncrackable/l2/samples/dex/*.dex
uncrackable/l2/samples/native/*.so
uncrackable/l3/samples/apks/*.apk
uncrackable/l3/samples/dex/*.dex
uncrackable/l3/samples/native/*.so

# Lab-local emulator/frida tooling (large, re-fetchable — see README setup section)
.tools/
uncrackable/tools/frida-server*
